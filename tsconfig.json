{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// bwip-js publishes its types only behind platform export conditions;
		// "browser" matches what Vite resolves at build time
		"customConditions": ["browser"],
		"types": ["$app/types", "bun", "vite/client", "web-bluetooth"]
	},
	"include": ["src", "vite.config.ts"]
}
